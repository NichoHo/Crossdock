# URL of the Go API
CROSSDOCK_API_URL=http://127.0.0.1:8080
# Must equal the API's CROSSDOCK_SERVICE_TOKEN and CROSSDOCK_IDENTITY_SIGNING_KEY (32+ chars each)
CROSSDOCK_SERVICE_TOKEN=
CROSSDOCK_IDENTITY_SIGNING_KEY=
# Signs the browser session cookie (32+ chars)
CROSSDOCK_SESSION_SECRET=
# Stand-in sign-in until a managed auth provider is wired: name:role:password, comma separated.
# Roles: operator, supervisor, admin
CROSSDOCK_WEB_USERS=sue:supervisor:change-me,olga:operator:change-me,ada:admin:change-me
