# TLS comes from Caddy: a public host name gets a Let's Encrypt certificate, and
# SITE_ADDRESS=localhost gets Caddy's own local CA for trying this on a laptop.
# Plain HTTP on port 80 redirects to HTTPS by default.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Content-Security-Policy is set by the web app (web/src/proxy.ts) because it carries a
		# per-request nonce for scripts.
		-Server
	}

	# /metrics stays inside the Compose network.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# External systems call the API with their own tokens.
	handle /v1/* {
		reverse_proxy api:8080
	}

	# Grafana signs people in itself. Anonymous viewing is off unless GRAFANA_ANONYMOUS=true.
	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	# Traces can carry order and tracking numbers, so the viewer needs a password.
	# Make the hash with:  docker run --rm caddy:2.9-alpine caddy hash-password
	handle /jaeger* {
		basic_auth {
			{$JAEGER_USER} {$JAEGER_PASSWORD_HASH}
		}
		reverse_proxy jaeger:16686
	}

	handle {
		reverse_proxy web:3000
	}
}
