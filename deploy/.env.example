# Copy to deploy/.env and fill in every value. Never commit deploy/.env.
# Generate secrets with:  openssl rand -base64 36
SITE_ADDRESS=crossdock.example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Shared between the web app and the API. At least 32 characters each.
CROSSDOCK_SERVICE_TOKEN=
CROSSDOCK_IDENTITY_SIGNING_KEY=
CROSSDOCK_SESSION_SECRET=
# 32 bytes as base64; encrypts webhook secrets at rest.
CROSSDOCK_SECRET_ENCRYPTION_KEY=

# name:role:password, comma separated. Roles: operator, supervisor, admin.
CROSSDOCK_WEB_USERS=

# Synthetic operators (docker compose --profile synthetic up -d)
SYNTHETIC_WAREHOUSE=wh-demo
SYNTHETIC_OPERATORS=4
SYNTHETIC_EVERY=20s

# Caddy basic auth for /jaeger. Hash with:  docker run --rm caddy:2.9-alpine caddy hash-password
# (write each $ in the hash as $$ so Compose does not read it as a variable)
JAEGER_USER=ops
JAEGER_PASSWORD_HASH=

# true lets anyone view Grafana without signing in. Leave false unless the data is synthetic and public.
GRAFANA_ANONYMOUS=false

# Requests per second per signed-in user, and per external API token. 0 turns a limit off.
RATE_LIMIT_USER=50
RATE_LIMIT_SYSTEM=10
